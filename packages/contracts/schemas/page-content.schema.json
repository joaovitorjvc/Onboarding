{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuagehub.local/schemas/page-content.json",
  "title": "PageContent",
  "description": "Conteudo_de_Pagina do NuageHub (Spec legacy-migration, Req. 3). Texto rico nunca contém HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "documentTitle", "navLabel", "hero", "blocks"],
  "properties": {
    "slug": {
      "$ref": "#/$defs/PageSlug"
    },
    "documentTitle": {
      "$ref": "#/$defs/Text"
    },
    "navLabel": {
      "$ref": "#/$defs/Text"
    },
    "hero": {
      "$ref": "#/$defs/Hero"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      }
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "PageSlug": {
      "type": "string",
      "enum": ["inicio", "primeiros-passos", "plataformas", "playbook"]
    },
    "Route": {
      "type": "string",
      "enum": ["/", "/primeiros-passos", "/plataformas", "/playbook"]
    },
    "Href": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "IconName": {
      "type": "string",
      "enum": [
        "arrow-right",
        "award",
        "book-open",
        "chevron-right",
        "circle-check",
        "clock",
        "compass",
        "external-link",
        "house",
        "layers",
        "receipt",
        "sparkles"
      ]
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "$ref": "#/$defs/Text"
        },
        "strong": {
          "type": "boolean"
        },
        "emphasis": {
          "type": "boolean"
        },
        "href": {
          "$ref": "#/$defs/Href"
        }
      }
    },
    "RichText": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Span"
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "style"],
      "properties": {
        "label": {
          "$ref": "#/$defs/Text"
        },
        "to": {
          "$ref": "#/$defs/Route"
        },
        "href": {
          "$ref": "#/$defs/Href"
        },
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "style": {
          "type": "string",
          "enum": ["primary", "secondary", "card"]
        }
      },
      "description": "Exatamente um destino: rota interna (to) ou link externo (href).",
      "dependentSchemas": {
        "to": {
          "not": {
            "required": ["href"]
          }
        }
      },
      "if": {
        "not": {
          "required": ["to"]
        }
      },
      "then": {
        "required": ["href"]
      }
    },
    "Hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "title", "description"],
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["home", "page"]
        },
        "badge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "icon": {
              "$ref": "#/$defs/IconName"
            },
            "text": {
              "$ref": "#/$defs/Text"
            }
          }
        },
        "eyebrow": {
          "$ref": "#/$defs/Text"
        },
        "title": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RichText"
          }
        },
        "description": {
          "$ref": "#/$defs/RichText"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      }
    },
    "Card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "accent", "tag", "title", "subtitle", "description", "action"],
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "accent": {
          "type": "string",
          "enum": ["blue", "purple", "teal"]
        },
        "tag": {
          "$ref": "#/$defs/Text"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "subtitle": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "$ref": "#/$defs/RichText"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "ChecklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "title", "description", "defaultDone"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "day": {
          "$ref": "#/$defs/Text"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "defaultDone": {
          "type": "boolean"
        }
      }
    },
    "LinkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "href": {
          "$ref": "#/$defs/Href"
        }
      }
    },
    "CadenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "action", "detail"],
      "properties": {
        "day": {
          "$ref": "#/$defs/Text"
        },
        "action": {
          "$ref": "#/$defs/Text"
        },
        "detail": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "SubtopicItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "$ref": "#/$defs/RichText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "enum": ["bullets", "steps"]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/RichText"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "links"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/LinkItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "cadence"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/CadenceItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "script"
            },
            "text": {
              "$ref": "#/$defs/Text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "actions"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Action"
              }
            }
          }
        }
      ]
    },
    "Subtopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content"],
      "properties": {
        "title": {
          "$ref": "#/$defs/Text"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SubtopicItem"
          }
        }
      }
    },
    "Block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cards"],
          "properties": {
            "type": {
              "const": "cards"
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Card"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "title", "meta", "items"],
          "properties": {
            "type": {
              "const": "checklist"
            },
            "label": {
              "$ref": "#/$defs/Text"
            },
            "title": {
              "$ref": "#/$defs/Text"
            },
            "meta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["icon", "text"],
              "properties": {
                "icon": {
                  "$ref": "#/$defs/IconName"
                },
                "text": {
                  "$ref": "#/$defs/Text"
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ChecklistItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "number", "title", "subtopics"],
          "properties": {
            "type": {
              "const": "topic"
            },
            "number": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            "title": {
              "$ref": "#/$defs/Text"
            },
            "subtopics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Subtopic"
              }
            }
          }
        }
      ]
    }
  }
}
