{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "dependentSchemas": {
          "to": {
            "not": {
              "required": [
                "href"
              ]
            }
          }
        },
        "description": "Exatamente um destino: rota interna (to) ou link externo (href).",
        "if": {
          "not": {
            "required": [
              "to"
            ]
          }
        },
        "properties": {
          "href": {
            "$ref": "#/components/schemas/Href"
          },
          "icon": {
            "$ref": "#/components/schemas/IconName"
          },
          "label": {
            "$ref": "#/components/schemas/Text"
          },
          "style": {
            "enum": [
              "primary",
              "secondary",
              "card"
            ],
            "type": "string"
          },
          "to": {
            "$ref": "#/components/schemas/Route"
          }
        },
        "required": [
          "label",
          "style"
        ],
        "then": {
          "required": [
            "href"
          ]
        },
        "type": "object"
      },
      "Block": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "cards": {
                "items": {
                  "$ref": "#/components/schemas/Card"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "cards"
              }
            },
            "required": [
              "type",
              "cards"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/ChecklistItem"
                },
                "minItems": 1,
                "type": "array"
              },
              "label": {
                "$ref": "#/components/schemas/Text"
              },
              "meta": {
                "additionalProperties": false,
                "properties": {
                  "icon": {
                    "$ref": "#/components/schemas/IconName"
                  },
                  "text": {
                    "$ref": "#/components/schemas/Text"
                  }
                },
                "required": [
                  "icon",
                  "text"
                ],
                "type": "object"
              },
              "title": {
                "$ref": "#/components/schemas/Text"
              },
              "type": {
                "const": "checklist"
              }
            },
            "required": [
              "type",
              "label",
              "title",
              "meta",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "number": {
                "pattern": "^[0-9]{2}$",
                "type": "string"
              },
              "subtopics": {
                "items": {
                  "$ref": "#/components/schemas/Subtopic"
                },
                "minItems": 1,
                "type": "array"
              },
              "title": {
                "$ref": "#/components/schemas/Text"
              },
              "type": {
                "const": "topic"
              }
            },
            "required": [
              "type",
              "number",
              "title",
              "subtopics"
            ],
            "type": "object"
          }
        ]
      },
      "CadenceItem": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Text"
          },
          "day": {
            "$ref": "#/components/schemas/Text"
          },
          "detail": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "day",
          "action",
          "detail"
        ],
        "type": "object"
      },
      "Card": {
        "additionalProperties": false,
        "properties": {
          "accent": {
            "enum": [
              "blue",
              "purple",
              "teal"
            ],
            "type": "string"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "description": {
            "$ref": "#/components/schemas/RichText"
          },
          "icon": {
            "$ref": "#/components/schemas/IconName"
          },
          "subtitle": {
            "$ref": "#/components/schemas/Text"
          },
          "tag": {
            "$ref": "#/components/schemas/Text"
          },
          "title": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "icon",
          "accent",
          "tag",
          "title",
          "subtitle",
          "description",
          "action"
        ],
        "type": "object"
      },
      "ChecklistItem": {
        "additionalProperties": false,
        "properties": {
          "day": {
            "$ref": "#/components/schemas/Text"
          },
          "defaultDone": {
            "type": "boolean"
          },
          "description": {
            "$ref": "#/components/schemas/Text"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "title": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "id",
          "day",
          "title",
          "description",
          "defaultDone"
        ],
        "type": "object"
      },
      "ErrorFormat": {
        "additionalProperties": false,
        "description": "Formato_de_Erro padronizado do NuageHub (Req. 13.2). Definição única.",
        "properties": {
          "code": {
            "description": "Código estável do erro.",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "type": "string"
          },
          "correlationId": {
            "description": "Identificador de correlação (x-correlation-id).",
            "format": "uuid",
            "type": "string"
          },
          "details": {
            "description": "Detalhes por campo (erros de validação).",
            "items": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "issue"
              ],
              "title": "ErrorDetail",
              "type": "object"
            },
            "type": "array"
          },
          "message": {
            "description": "Mensagem em pt-BR, sem stack trace.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "description": "Status HTTP.",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId",
          "status"
        ],
        "title": "ErrorFormat",
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "status": {
            "description": "Estado operacional da API.",
            "enum": [
              "ok"
            ],
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Hero": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array"
          },
          "badge": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/components/schemas/IconName"
              },
              "text": {
                "$ref": "#/components/schemas/Text"
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "description": {
            "$ref": "#/components/schemas/RichText"
          },
          "eyebrow": {
            "$ref": "#/components/schemas/Text"
          },
          "title": {
            "items": {
              "$ref": "#/components/schemas/RichText"
            },
            "minItems": 1,
            "type": "array"
          },
          "variant": {
            "enum": [
              "home",
              "page"
            ],
            "type": "string"
          }
        },
        "required": [
          "variant",
          "title",
          "description"
        ],
        "type": "object"
      },
      "Href": {
        "pattern": "^https://[^\\s]+$",
        "type": "string"
      },
      "IconName": {
        "enum": [
          "arrow-right",
          "award",
          "book-open",
          "chevron-right",
          "circle-check",
          "clock",
          "compass",
          "external-link",
          "house",
          "layers",
          "receipt",
          "sparkles"
        ],
        "type": "string"
      },
      "LinkItem": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "$ref": "#/components/schemas/Text"
          },
          "href": {
            "$ref": "#/components/schemas/Href"
          },
          "title": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "title",
          "description"
        ],
        "type": "object"
      },
      "PageContent": {
        "additionalProperties": false,
        "description": "Conteudo_de_Pagina do NuageHub (Spec legacy-migration, Req. 3). Texto rico nunca contém HTML.",
        "properties": {
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array"
          },
          "documentTitle": {
            "$ref": "#/components/schemas/Text"
          },
          "hero": {
            "$ref": "#/components/schemas/Hero"
          },
          "navLabel": {
            "$ref": "#/components/schemas/Text"
          },
          "slug": {
            "$ref": "#/components/schemas/PageSlug"
          }
        },
        "required": [
          "slug",
          "documentTitle",
          "navLabel",
          "hero",
          "blocks"
        ],
        "title": "PageContent",
        "type": "object"
      },
      "PageSlug": {
        "enum": [
          "inicio",
          "primeiros-passos",
          "plataformas",
          "playbook"
        ],
        "type": "string"
      },
      "RichText": {
        "items": {
          "$ref": "#/components/schemas/Span"
        },
        "minItems": 1,
        "type": "array"
      },
      "Route": {
        "enum": [
          "/",
          "/primeiros-passos",
          "/plataformas",
          "/playbook"
        ],
        "type": "string"
      },
      "Span": {
        "additionalProperties": false,
        "properties": {
          "emphasis": {
            "type": "boolean"
          },
          "href": {
            "$ref": "#/components/schemas/Href"
          },
          "strong": {
            "type": "boolean"
          },
          "text": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Subtopic": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/SubtopicItem"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "$ref": "#/components/schemas/Text"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "type": "object"
      },
      "SubtopicItem": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "text": {
                "$ref": "#/components/schemas/RichText"
              },
              "type": {
                "const": "paragraph"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/RichText"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "enum": [
                  "bullets",
                  "steps"
                ]
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/LinkItem"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "links"
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/CadenceItem"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "cadence"
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "text": {
                "$ref": "#/components/schemas/Text"
              },
              "type": {
                "const": "script"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/Action"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "actions"
              }
            },
            "required": [
              "type",
              "items"
            ],
            "type": "object"
          }
        ]
      },
      "Text": {
        "minLength": 1,
        "type": "string"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "API do portal de onboarding do NuageHub.",
    "title": "NuageHub API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/content/pages": {
      "get": {
        "operationId": "ContentController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "documentTitle": {
                        "type": "string"
                      },
                      "navLabel": {
                        "type": "string"
                      },
                      "slug": {
                        "enum": [
                          "inicio",
                          "primeiros-passos",
                          "plataformas",
                          "playbook"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "navLabel",
                      "documentTitle"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Lista as páginas de conteúdo na ordem de navegação.",
        "tags": [
          "content"
        ]
      }
    },
    "/api/v1/content/pages/{slug}": {
      "get": {
        "operationId": "ContentController_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageContent"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorFormat"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Obtém uma página de conteúdo pelo slug.",
        "tags": [
          "content"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Verifica a disponibilidade da API.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
