{
  "name": "@nuagehub/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos compartilhados: Formato_de_Erro e tipos gerados do OpenAPI do App_API",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/error-format.schema.json": "./schemas/error-format.schema.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node scripts/generate.mts",
    "check": "node scripts/generate.mts --check",
    "lint": "eslint . && pnpm run lint:py",
    "typecheck": "tsc -p tsconfig.json && pnpm run typecheck:py",
    "test": "vitest run && pnpm run test:py",
    "lint:py": "cd python && uv run ruff check . && uv run ruff format --check .",
    "typecheck:py": "cd python && uv run mypy --config-file ../../../mypy.ini nuagehub_contracts scripts",
    "test:py": "cd python && uv run pytest"
  },
  "devDependencies": {
    "@nuagehub/config": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
