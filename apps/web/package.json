{
  "name": "@nuagehub/web",
  "version": "0.0.0",
  "private": true,
  "description": "App_Web: frontend React do NuageHub",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --project=e2e --project=visual",
    "e2e:baseline": "playwright test --project=legacy-baseline --update-snapshots"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@nuagehub/contracts": "workspace:*",
    "lucide-react": "1.53.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@nuagehub/config": "workspace:*",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
