# Variáveis de ambiente do Monorepo. Copie para .env e preencha localmente.
# Nunca versione valores reais (Req. 7.8). Cada app documenta as suas no próprio .env.example.

# App_API (apps/api)
NODE_ENV=development
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
CONTENT_CACHE_MAX_AGE_SECONDS=300

# App_Web (apps/web)
VITE_API_BASE_URL=http://localhost:3000

# Modulo_IA de exemplo (services/ai/example)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://provider.example.com
AI_PROVIDER_TIMEOUT_SECONDS=10
